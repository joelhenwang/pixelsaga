# Copy to .env and fill real values. Never commit .env.
POSTGRES_DB=worldsim
POSTGRES_USER=worldsim
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5432
# Async SQLAlchemy URL used by the app (password comes from your local .env).
DATABASE_URL=postgresql+asyncpg://worldsim:changeme-local-only@localhost:5432/worldsim
# Later stages: MODEL_GATEWAY_PROFILE, OPENROUTER_API_KEY, LANGSMITH_API_KEY.
# Typed settings (S0-CONFIG-001; prefix WORLDSIM_, nested delimiter __).
WORLDSIM_APP__ENVIRONMENT=local
WORLDSIM_APP__HOST=127.0.0.1
WORLDSIM_APP__PORT=8000
# WORLDSIM_PROVIDER__OPENROUTER_API_KEY=
# WORLDSIM_PROVIDER__OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Manual live probe only (never a gate): WORLDSIM_MODEL_LIVE_PROBE=1
# WORLDSIM_SECURITY__PUBLIC_BIND_ALLOW=false
