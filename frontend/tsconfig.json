{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@gen": ["../content/clients/worldsim.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
